{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group all Nix flake input updates into a single PR",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs"
    },
    {
      "description": "Pin and track the answers-data URL handled by the custom regex manager",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["test_done.py"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin the upstream branch ref behind the Project Euler answers data file to a commit SHA, then keep the SHA current",
      "managerFilePatterns": ["/^test_done\\.py$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/lucky-bai/projecteuler-solutions/refs/heads/(?<currentValue>[^/]+)/Solutions\\.md",
        "https://raw\\.githubusercontent\\.com/lucky-bai/projecteuler-solutions/(?<currentDigest>[0-9a-f]{40})/Solutions\\.md"
      ],
      "depNameTemplate": "lucky-bai/projecteuler-solutions (answers data)",
      "packageNameTemplate": "https://github.com/lucky-bai/projecteuler-solutions",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git",
      "autoReplaceStringTemplate": "https://raw.githubusercontent.com/lucky-bai/projecteuler-solutions/{{#if newDigest}}{{newDigest}}{{else}}{{newValue}}{{/if}}/Solutions.md"
    }
  ]
}
